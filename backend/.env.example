# Agentflow_AI Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Leave empty to use automatic zero-config In-Memory MongoDB)
MONGODB_URI=

# JWT Secret
JWT_SECRET=agentflow-jwt-secure-secret-key-32-chars-min
JWT_EXPIRES_IN=7d

# Credential Encryption Key (32 characters for AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=12345678901234567890123456789012

# Background Queue Redis (Leave empty for zero-config In-Memory Queue)
REDIS_URL=

# AI Provider API Keys (Optional - deterministic generator works out of the box)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Third-Party OAuth Credentials (Optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
